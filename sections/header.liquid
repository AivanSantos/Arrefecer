<div class="relative bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex justify-between items-center py-6 md:justify-start md:space-x-10">
      <!-- Logo -->
      <div class="flex justify-start lg:w-0 lg:flex-1">
        <a href="/">
          {% if settings.logo %}
            {{ settings.logo | img_url: '180x' | img_tag: shop.name }}
          {% else %}
            <span class="text-xl font-bold">{{ shop.name }}</span>
          {% endif %}
        </a>
      </div>

      <!-- Menu -->
      <nav class="hidden md:flex space-x-10">
        {% for link in linklists.main-menu.links %}
          <a href="{{ link.url }}" class="text-base font-medium text-gray-500 hover:text-gray-900">
            {{ link.title }}
          </a>
        {% endfor %}
      </nav>

      <!-- Botões -->
      <div class="hidden md:flex items-center justify-end md:flex-1 lg:w-0">
        <a href="/contact" class="ml-8 whitespace-nowrap inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-arrefecer-600 hover:bg-arrefecer-700">
          Contacto
        </a>
      </div>
    </div>
  </div>
</div> 